APP_NAME="Antico Burger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anticoburger
DB_USERNAME=root
DB_PASSWORD=

# Separate MySQL database used only by the concurrency tests (must end with "_test").
DB_TEST_DATABASE=anticoburger_test

# --- Booking (config/booking.php) ---
# Timezone used to interpret schedules, blocks and requested times (instants are stored in UTC).
BOOKING_TIMEZONE=Europe/Rome
# Largest party size selectable on tables and accepted by the API.
BOOKING_MAX_PARTY_SIZE=20
# How many months after the current one the public calendar can show.
BOOKING_CALENDAR_MAX_MONTHS_AHEAD=12
# Public API rate limits, requests per minute.
BOOKING_RATE_LIMIT_READ=60
BOOKING_RATE_LIMIT_BOOKING_PER_PHONE=5
BOOKING_RATE_LIMIT_BOOKING_PER_IP=20
BOOKING_RATE_LIMIT_ACCESS=30
# Comma separated proxy IPs (or *) in front of the app, so rate limits see the real client IP.
TRUSTED_PROXIES=

# --- CORS (config/cors.php) ---
# Comma separated origins allowed to call /api/*. Production: https://app.anticoburger.it
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
